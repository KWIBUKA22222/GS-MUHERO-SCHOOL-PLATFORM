# Kopiya iyi dosiye nka ".env" hanyuma uyuzuze. Ntuzigere uyishyira ahagaragara.
PORT=3000
# Aderesi y'urubuga (ikoreshwa mu butumwa bwa SMS)
BASE_URL=https://gsmuhero.rw
# Shyiraho 1 igihe urubuga rukoresha HTTPS (rugomba kuba rukoresha HTTPS)
COOKIE_SECURE=1
# Shyiraho 1 igihe seriveri iri inyuma ya proxy (Render, Railway, nginx)
TRUST_PROXY=1
# Aho amakuru abikwa (ahantu hahoraho, hakorerwa backup)
DB_PATH=./data/gsm.sqlite

# Konti ya mbere y'ubuyobozi (ikoreshwa na "npm run seed")
ADMIN_NAME=Umuyobozi
ADMIN_EMAIL=ubuyobozi@gsmuhero.rw
ADMIN_PASSWORD=hindura-iri-jambobanga-rirerire

# SMS: console (igerageza, nta SMS zijya) | africastalking
SMS_PROVIDER=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
